// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum FieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  MULTISELECT
}

enum FieldStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  leads        Lead[]
  customFields CustomField[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  email     String
  phone     String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  createdLeads  Lead[] @relation("LeadCreator")
  assignedLeads Lead[] @relation("LeadAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Lead {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String    @db.Uuid
  name         String
  phone        String?
  countryCode  String?
  e164         String?
  email        String?
  assignedTo   String?   @db.Uuid
  followUpDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  user     User   @relation("LeadCreator", fields: [userId], references: [id])
  assignee User?  @relation("LeadAssignee", fields: [assignedTo], references: [id])

  customValues LeadCustomFieldValue[]

  @@index([tenantId])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([followUpDate])
  @@map("leads")
}

model CustomField {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  label     String
  type      FieldType
  status    FieldStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  values LeadCustomFieldValue[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("custom_fields")
}

model LeadCustomFieldValue {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  fieldId   String   @db.Uuid
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([fieldId, value])
  @@index([leadId])
  @@map("lead_custom_field_values")
}
