{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",

		"module": "commonjs",
		"target": "es2022",

		"types": ["node"],

		"sourceMap": true,

		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		"strict": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src"],

	"exclude": ["node_modules", "dist"]
}
